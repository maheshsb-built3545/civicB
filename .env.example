# =======================================================
# SERVER CONFIGURATION
# =======================================================
PORT=3000
APP_URL="http://localhost:3000"

# =======================================================
# GEMINI AI (Required for spam screening)
# =======================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# =======================================================
# MONGODB (Required for persistence & authentication)
# =======================================================
# Get from: MongoDB Atlas > Connect > Drivers
# Replace <password> with your Atlas database user password.
# The database name (kopargaonpriority) is specified in the URI.
MONGODB_URI="mongodb+srv://kpg_admin:<password>@cluster0.xxxxx.mongodb.net/kopargaonpriority?retryWrites=true&w=majority"

# =======================================================
# JWT (Required for authentication)
# =======================================================
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_hex_secret_at_least_64_chars"

# =======================================================
# SEED SCRIPT (Required only when running: npx tsx src/server/seed.ts)
# =======================================================
# Passwords for the initial demo admin and officer accounts.
# These are only read by the seed script — they are NOT used at runtime.
# Do NOT reuse weak passwords. These become bcrypt-hashed in MongoDB.
SEED_ADMIN_PASSWORD="replace_with_strong_admin_password"
SEED_OFFICER_PASSWORD="replace_with_strong_officer_password"
